#!/usr/bin/env bash
#
# cyberpi - start the CyberPi harness.
#
# The launcher checks the platform, makes sure the CyberPi package and the
# cyber theme are in place, and then starts the Pi coding agent inside the
# engagement directory with the package loaded.
#
# Usage:
#   cyberpi [options] [message...]
#   cyberpi new <name> [options]
#
# Options:
#   --engagement <dir>  Engagement directory to work in (default: $CYBERPI_ENGAGEMENT or the working directory)
#   --check              Run cyberpi-doctor and exit
#   --print              Run Pi in print mode (one shot, text output)
#   --json               Run Pi in JSON mode (one shot, JSONL events)
#   --theme <name>       Use a specific theme for this run
#   --no-theme           Keep the current theme selection
#   --help               Show this help
#
set -euo pipefail

readonly PROGRAM_NAME="cyberpi"
readonly THEME_NAME="cyber"

PI_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
SETTINGS_FILE="$PI_AGENT_DIR/settings.json"
THEME_FILE="$PI_AGENT_DIR/themes/cyber.json"
PACKAGE_ROOT=""

CHECK_ONLY=0
PRINT_MODE=0
JSON_MODE=0
NO_THEME=0
THEME_OVERRIDE=""
EFFECTIVE_THEME=""
ENGAGEMENT_DIR=""
ENGAGEMENT_ROOT=""
NEW_ENGAGEMENT=""
CLIENT_NAME=""
declare -a PASSTHROUGH=()

if [[ -t 1 && -z "${NO_COLOR:-}" && "${CYBERPI_NO_COLOR:-}" != "1" ]]; then
	C_RESET=$'\033[0m'
	C_BOLD=$'\033[1m'
	C_DIM=$'\033[2m'
	C_OK=$'\033[32m'
	C_WARN=$'\033[33m'
	C_FAIL=$'\033[31m'
else
	C_RESET=""
	C_BOLD=""
	C_DIM=""
	C_OK=""
	C_WARN=""
	C_FAIL=""
fi

info() { printf '%s\n' "$*"; }
step() { printf '%s==>%s %s\n' "$C_BOLD" "$C_RESET" "$*"; }
warn() { printf '%swarning:%s %s\n' "$C_WARN" "$C_RESET" "$*" >&2; }
fail() { printf '%serror:%s %s\n' "$C_FAIL" "$C_RESET" "$*" >&2; }

usage() {
	cat <<'USAGE'
cyberpi - start the CyberPi security engagement harness.

Usage:
  cyberpi [options] [message...]
  cyberpi new <name> [options]

Options:
  --engagement <dir>  Engagement directory to work in (default: $CYBERPI_ENGAGEMENT or the working directory)
  --check              Run cyberpi-doctor and exit
  --print              Run Pi in print mode (one shot, text output)
  --json               Run Pi in JSON mode (one shot, JSONL events)
  --theme <name>       Use a specific theme for this run
  --no-theme           Keep the current theme selection
  --help               Show this help

Examples:
  cyberpi new acme-web-2025-03
  cyberpi --engagement ./acme-web-2025-03
  cyberpi --print "summarize the engagement"
USAGE
}

# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------

settings_packages() {
	if ! command -v node >/dev/null 2>&1; then return 0; fi
	node -e '
		const fs = require("node:fs");
		const file = process.argv[1];
		if (!fs.existsSync(file)) process.exit(0);
		let data;
		try { data = JSON.parse(fs.readFileSync(file, "utf8")); } catch { process.exit(0); }
		const list = Array.isArray(data.packages) ? data.packages : [];
		for (const entry of list) {
			if (typeof entry === "string") console.log(entry);
			else if (entry && typeof entry.source === "string") console.log(entry.source);
		}
	' "$SETTINGS_FILE" 2>/dev/null || true
}

settings_theme() {
	if ! command -v node >/dev/null 2>&1; then printf ''; return 0; fi
	node -e '
		const fs = require("node:fs");
		const file = process.argv[1];
		if (!fs.existsSync(file)) { console.log(""); process.exit(0); }
		let data;
		try { data = JSON.parse(fs.readFileSync(file, "utf8")); } catch { console.log(""); process.exit(0); }
		console.log(typeof data.theme === "string" ? data.theme : "");
	' "$SETTINGS_FILE" 2>/dev/null || true
}

# Select the cyber theme in the Pi settings when no theme was chosen yet.
# EFFECTIVE_THEME ends up empty when the operator picked a theme themselves.
select_theme() {
	local theme
	EFFECTIVE_THEME=""
	theme=$(settings_theme)
	if [[ -n "$theme" && "$theme" != "system" && "$theme" != "$THEME_NAME" ]]; then
		return 0
	fi
	if [[ ! -f "$THEME_FILE" ]]; then
		warn "the cyber theme is not installed at $THEME_FILE; the package still provides it."
		EFFECTIVE_THEME="$THEME_NAME"
		return 0
	fi
	if ! command -v node >/dev/null 2>&1; then
		warn "node is not available, the theme selection was not written to $SETTINGS_FILE."
		EFFECTIVE_THEME="$THEME_NAME"
		return 0
	fi
	node -e '
		const fs = require("node:fs");
		const path = require("node:path");
		const file = process.argv[1];
		const theme = process.argv[2];
		let data = {};
		if (fs.existsSync(file)) {
			try { data = JSON.parse(fs.readFileSync(file, "utf8")); } catch { data = {}; }
		}
		if (typeof data !== "object" || data === null || Array.isArray(data)) data = {};
		if (typeof data.theme === "string" && data.theme !== "" && data.theme !== "system") {
			console.log("kept");
			process.exit(0);
		}
		data.theme = theme;
		fs.mkdirSync(path.dirname(file), { recursive: true });
		fs.writeFileSync(file, JSON.stringify(data, null, 2) + "\n", "utf8");
		console.log("set");
	' "$SETTINGS_FILE" "$THEME_NAME" 2>/dev/null || true
	EFFECTIVE_THEME="$THEME_NAME"
}

resolve_package_root() {
	local candidate source absolute
	if [[ -n "${CYBERPI_PACKAGE_ROOT:-}" ]]; then
		printf '%s\n' "$CYBERPI_PACKAGE_ROOT"
		return 0
	fi
	candidate="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd || true)"
	if [[ -n "$candidate" && -f "$candidate/package.json" ]] && grep -q 'cyberpi-harness' "$candidate/package.json" 2>/dev/null; then
		printf '%s\n' "$candidate"
		return 0
	fi
	for candidate in /usr/local/lib/cyberpi /opt/cyberpi "$HOME/.cyberpi/package"; do
		if [[ -f "$candidate/package.json" ]]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	while IFS= read -r source; do
		[[ -z "$source" ]] && continue
		case "$source" in
		/*) absolute=$source ;;
		~*) absolute="${source/#\~/$HOME}" ;;
		*) continue ;;
		esac
		if [[ -f "$absolute/package.json" ]]; then
			printf '%s\n' "$absolute"
			return 0
		fi
	done < <(settings_packages)
	return 1
}

package_is_registered() {
	local root=$1 source resolved
	while IFS= read -r source; do
		[[ -z "$source" ]] && continue
		resolved=$source
		case "$resolved" in
		~*) resolved="${resolved/#\~/$HOME}" ;;
		esac
		if [[ "$resolved" == "$root" ]]; then
			return 0
		fi
	done < <(settings_packages)
	return 1
}

# --------------------------------------------------------------------------
# Platform gate
# --------------------------------------------------------------------------

check_platform() {
	local system
	system=$(uname -s 2>/dev/null || echo unknown)
	if [[ "$system" != "Linux" ]]; then
		fail "CyberPi targets Kali Linux and is not supported on $system."
		fail "Run it inside Kali Linux (bare metal, a VM or a container)."
		exit 1
	fi
	local id like
	id=$(sed -n 's/^ID="\{0,1\}\(.*\)"\{0,1\}$/\1/p' /etc/os-release 2>/dev/null | head -n 1 || true)
	like=$(sed -n 's/^ID_LIKE="\{0,1\}\(.*\)"\{0,1\}$/\1/p' /etc/os-release 2>/dev/null | head -n 1 || true)
	if [[ "$id" == "kali" || "$like" == *kali* ]]; then
		return 0
	fi
	if [[ "${CYBERPI_STRICT_KALI:-}" == "1" ]]; then
		fail "CyberPi requires Kali Linux and CYBERPI_STRICT_KALI=1 is set."
		exit 1
	fi
	warn "this host is not Kali Linux; most tools work, some are packaged differently."
}

# --------------------------------------------------------------------------
# Engagement creation
# --------------------------------------------------------------------------

create_engagement() {
	local name=$1
	local root
	if [[ "$name" = /* ]]; then
		root="${name%/}"
	else
		root="$PWD/$name"
	fi
	ENGAGEMENT_ROOT="$root"
	local dir_name
	dir_name=$(basename "$root")
	if [[ -e "$root" && ! -d "$root" ]]; then
		fail "$root exists and is not a directory."
		exit 1
	fi
	mkdir -p "$root"
	mkdir -p "$root/.cyberpi/artifacts" "$root/.cyberpi/findings" "$root/.cyberpi/notes" "$root/.cyberpi/reports" "$root/.cyberpi/cache"
	local scope_file="$root/.cyberpi/scope.json"
	if [[ -f "$scope_file" ]]; then
		warn "$scope_file already exists and was left untouched."
	else
		cat >"$scope_file" <<SCOPE
{
  "engagement": "$dir_name",
  "client": "$CLIENT_NAME",
  "authorization": {
    "statement": "Replace this with the written authorization that covers this engagement.",
    "authorizedBy": "",
    "start": "",
    "end": ""
  },
  "techniques": [],
  "allowSelfTest": true,
  "rules": [
    // Add the targets the client authorized. Until a rule is present only
    // self-tests against the local machine are allowed.
    // {
    //   "id": "rule-1",
    //   "target": "10.0.0.0/24",
    //   "ports": [80, 443],
    //   "notes": "Authorized by the statement of work dated 2025-01-01."
    // }
  ]
}
SCOPE
	fi
	cat >"$root/README.md" <<README
# $dir_name

Engagement directory for CyberPi.

- \`.cyberpi/scope.json\` - the authorized targets, techniques and rules. Nothing outside this file is reachable.
- \`.cyberpi/journal.jsonl\` - the append only record of every action CyberPi took.
- \`.cyberpi/findings/\` - the findings that were proven.
- \`.cyberpi/artifacts/\` - the raw output of every scanner.
- \`.cyberpi/surface.json\` - the attack surface index.
- \`.cyberpi/reports/\` - the generated reports.

Start the harness here with \`cyberpi\`, and render the report with \`cyberpi-report\`.
README
	step "created the engagement $dir_name in $root"
	return 0
}

# --------------------------------------------------------------------------
# Argument parsing
# --------------------------------------------------------------------------

parse_args() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		new)
			[[ $# -ge 2 ]] || { fail "cyberpi new needs an engagement name."; exit 2; }
			NEW_ENGAGEMENT=$2
			shift
			;;
		--engagement)
			[[ $# -ge 2 ]] || { fail "--engagement needs a directory"; exit 2; }
			ENGAGEMENT_DIR=$2
			shift
			;;
		--engagement=*)
			ENGAGEMENT_DIR=${1#*=}
			;;
		--client)
			[[ $# -ge 2 ]] || { fail "--client needs a name"; exit 2; }
			CLIENT_NAME=$2
			shift
			;;
		--client=*)
			CLIENT_NAME=${1#*=}
			;;
		--check)
			CHECK_ONLY=1
			;;
		--print)
			PRINT_MODE=1
			;;
		--json)
			JSON_MODE=1
			;;
		--theme)
			[[ $# -ge 2 ]] || { fail "--theme needs a name"; exit 2; }
			THEME_OVERRIDE=$2
			shift
			;;
		--theme=*)
			THEME_OVERRIDE=${1#*=}
			;;
		--no-theme)
			NO_THEME=1
			;;
		--help | -h)
			usage
			exit 0
			;;
		--)
			shift
			while [[ $# -gt 0 ]]; do
				PASSTHROUGH+=("$1")
				shift
			done
			break
			;;
		*)
			PASSTHROUGH+=("$1")
			;;
		esac
		shift
	done
}

# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------

main() {
	parse_args "$@"

	PACKAGE_ROOT="$(resolve_package_root || true)"

	if [[ -n "$NEW_ENGAGEMENT" ]]; then
		create_engagement "$NEW_ENGAGEMENT"
		ENGAGEMENT_DIR="$ENGAGEMENT_ROOT"
	fi

	if [[ -z "$ENGAGEMENT_DIR" ]]; then
		ENGAGEMENT_DIR="${CYBERPI_ENGAGEMENT:-$PWD}"
	fi
	if [[ ! "$ENGAGEMENT_DIR" = /* ]]; then
		ENGAGEMENT_DIR="$PWD/$ENGAGEMENT_DIR"
	fi
	ENGAGEMENT_DIR="${ENGAGEMENT_DIR%/}"
	[[ -n "$ENGAGEMENT_DIR" ]] || ENGAGEMENT_DIR=$PWD

	if [[ ! -d "$ENGAGEMENT_DIR" ]]; then
		fail "the engagement directory $ENGAGEMENT_DIR does not exist."
		exit 1
	fi

	# The doctor reports on the platform itself, so it runs before the gate.
	if [[ $CHECK_ONLY -eq 1 ]]; then
		local doctor=""
		if [[ -n "$PACKAGE_ROOT" && -f "$PACKAGE_ROOT/bin/cyberpi-doctor" ]]; then
			doctor="$PACKAGE_ROOT/bin/cyberpi-doctor"
		elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/cyberpi-doctor" ]]; then
			doctor="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cyberpi-doctor"
		else
			fail "cyberpi-doctor was not found."
			exit 1
		fi
		if [[ -x "$doctor" ]]; then
			exec "$doctor" --engagement "$ENGAGEMENT_DIR"
		fi
		exec bash "$doctor" --engagement "$ENGAGEMENT_DIR"
	fi

	check_platform

	local pi_path
	pi_path=$(command -v pi 2>/dev/null || true)
	if [[ -z "$pi_path" ]]; then
		fail "the Pi coding agent is not installed."
		fail "Install it with: curl -fsSL https://pi.dev/install.sh | sh"
		exit 1
	fi

	if [[ -z "$PACKAGE_ROOT" ]]; then
		fail "the CyberPi package was not found; re-run install.sh or set CYBERPI_PACKAGE_ROOT."
		exit 1
	fi

	if [[ $NO_THEME -eq 0 ]]; then
		if [[ -z "$THEME_OVERRIDE" ]]; then
			select_theme
			THEME_OVERRIDE="$EFFECTIVE_THEME"
		fi
	fi

	if [[ ! -f "$ENGAGEMENT_DIR/.cyberpi/scope.json" ]]; then
		warn "no scope file in $ENGAGEMENT_DIR/.cyberpi/scope.json; every action will be refused until it exists."
		warn "create one with: cyberpi new <name>"
	fi

	declare -a pi_cmd=()
	pi_cmd+=("$pi_path")
	if ! package_is_registered "$PACKAGE_ROOT"; then
		pi_cmd+=(-e "$PACKAGE_ROOT")
	fi
	if [[ -n "$THEME_OVERRIDE" ]]; then
		pi_cmd+=(--use-theme "$THEME_OVERRIDE")
	fi
	if [[ $PRINT_MODE -eq 1 ]]; then
		if [[ ${#PASSTHROUGH[@]} -eq 0 ]]; then
			fail "--print needs a prompt, for example: cyberpi --print \"summarize the engagement\""
			exit 2
		fi
		pi_cmd+=(--print)
	fi
	if [[ $JSON_MODE -eq 1 ]]; then
		if [[ ${#PASSTHROUGH[@]} -eq 0 ]]; then
			fail "--json needs a prompt, for example: cyberpi --json \"summarize the engagement\""
			exit 2
		fi
		pi_cmd+=(--mode json)
	fi
	if [[ ${#PASSTHROUGH[@]} -gt 0 ]]; then
		pi_cmd+=("${PASSTHROUGH[@]}")
	fi

	export CYBERPI_ENGAGEMENT="$ENGAGEMENT_DIR"
	cd "$ENGAGEMENT_DIR"
	exec "${pi_cmd[@]}"
}

main "$@"
