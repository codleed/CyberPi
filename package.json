{
	"name": "cyberpi-harness",
	"version": "0.1.0",
	"description": "CyberPi - a Kali Linux security engagement harness that extends the Pi coding agent with pentest tooling, CVE intelligence, and engagement workflows",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"pi-package",
		"security",
		"pentest",
		"red-team",
		"kali-linux",
		"cve",
		"vulnerability-assessment"
	],
	"pi": {
		"extensions": [
			"./extensions/**/*.ts"
		],
		"skills": [
			"./skills"
		],
		"prompts": [
			"./prompts/*.md"
		],
		"themes": [
			"./themes/*.json"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts",
		"verify": "node scripts/verify-resources.mjs",
		"check": "npm run typecheck && npm test && npm run verify",
		"doctor": "bash bin/cyberpi-doctor",
		"cve-sync": "python3 tools/cvedb/cvedb.py sync"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@types/node": "22.19.19",
		"typebox": "1.3.27",
		"typescript": "5.9.2"
	}
}
